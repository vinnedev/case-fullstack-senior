# Local: host localhost; no Docker o compose injeta DATABASE_URL com host db
DATABASE_URL=postgresql://relay:relay@localhost:5433/relay
# Observabilidade (wide events): erros/lentos sempre logam; sucessos são amostrados
LOG_SLOW_THRESHOLD_MS=1000
LOG_SUCCESS_SAMPLE_RATE=1.0
LOG_SUPPRESS_PROBE_ROUTES=true
CORS_ORIGINS=http://localhost:5173
