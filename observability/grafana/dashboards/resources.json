{
  "title": "Resources",
  "uid": "relay-resources",
  "tags": [
    "relay"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "description": "Recursos do host (cgroup raiz do cAdvisor) e por processo (process_* de cada serviço). Nota: sob runtimes que não expõem containers ao cAdvisor (ex.: OrbStack), a visão por container não existe — host + processo cobrem CPU/RAM; rede e disco são do host.",
  "panels": [
    {
      "type": "stat",
      "title": "CPU do host",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{id=\"/\"}[2m])) * 100 / scalar(machine_cpu_cores)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ]
    },
    {
