{
  "uid": "relay-dlq",
  "title": "DLQ — Dead Letter Queue",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "relay"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jobs na DLQ",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_dlq_total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tempo desde a última entrada",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "nunca"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_dlq_seconds_since_last > bool -1 == 1 or pg_dlq_seconds_since_last",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Entradas na DLQ ao longo do tempo",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_dlq_total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "total na DLQ"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Auditoria completa (todas as colunas)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-relay"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "failed_at",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT id, job_id, company_id, kind, attempts, last_error, trace_id, job_created_at, failed_at FROM dead_letter_jobs ORDER BY failed_at DESC LIMIT 200",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-relay"
          }
        }
      ]
    }
  ]
}
