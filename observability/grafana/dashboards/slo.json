{
  "uid": "relay-slo",
  "title": "SLOs & Alerts",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "tags": ["relay", "slo", "alerts"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidade API (5m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.995}, {"color": "green", "value": 0.999}] }}, "overrides": []},
      "targets": [{"refId": "A", "expr": "relay:slo_api_availability:ratio5m"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests API abaixo de 1s (5m)",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.95}, {"color": "green", "value": 0.99}] }}, "overrides": []},
      "targets": [{"refId": "A", "expr": "relay:slo_api_latency_under_1s:ratio5m"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worker sucesso (5m)",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.99}, {"color": "green", "value": 0.999}] }}, "overrides": []},
      "targets": [{"refId": "A", "expr": "relay:slo_worker_success:ratio5m"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLOs ao longo do tempo",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "relay:slo_api_availability:ratio5m", "legendFormat": "disponibilidade"},
        {"refId": "B", "expr": "relay:slo_api_latency_under_1s:ratio5m", "legendFormat": "latência < 1s"},
        {"refId": "C", "expr": "relay:slo_worker_success:ratio5m", "legendFormat": "worker sucesso"}
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Alertas ativos",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\"}"}]
    }
  ]
}
