    {
      "id": 40,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Últimos erros (api + worker)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|worker\", level=\"error\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Eventos de erro /s",
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service=~\"api|worker\", level=\"error\"} [5m])) by (service)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
